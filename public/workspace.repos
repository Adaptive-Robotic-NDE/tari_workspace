# workspace.repos -- every repository, in one file.
#
# GENERATED FILE -- do not edit. Produced from ../workspace.repos by
# tools/make_public_manifests.py. Edit that manifest and regenerate.
#
# This is the public form: it names the public mirrors over HTTPS, so it
# needs no GitHub account, no SSH key and no membership of any
# organisation. Repositories with no public counterpart are commented
# out below, with the reason.
#
#
#     vcs import < workspace.repos
#
# THIS FILE IS AN AGGREGATE AND IS NOT THE SOURCE OF TRUTH. The layered
# manifests are -- container.repos, sim.repos, acq.repos, hw.repos, site.repos
# -- and tari.bash imports those, never this one. This exists for the case
# where you want everything at once and do not care about layering.
#
# It had drifted: it named a repository that does not exist, pointed several
# packages at different remotes than the layers do, and pinned different
# branches. Regenerate it rather than editing it by hand:
#
#     ./tari.bash --check-remotes      # verifies the layers, not this file
#     python3 - <<'EOF'
#     import yaml
#     out = {}
#     for f in ("container.repos","sim.repos","acq.repos","hw.repos","site.repos"):
#         out.update((yaml.safe_load(open(f)) or {}).get("repositories") or {})
#     print(yaml.safe_dump({"repositories": out}, sort_keys=False))
#     EOF
#
# Layer of origin is noted against each entry.

repositories:
  # from container.repos
  container:
    type: git
    url: https://github.com/Adaptive-Robotic-NDE/tari_container.git
    version: iron
  # from sim.repos
  ros_ws/src/tari_ros:
    type: git
    url: https://github.com/Adaptive-Robotic-NDE/tari_ros.git
    version: iron
  # from sim.repos
  ros_ws/src/dgpython-ros2motion:
    type: git
    url: https://github.com/Adaptive-Robotic-NDE/dgpython-ros2motion.git
    version: iron
  # from sim.repos
  ros_ws/src/moveit_task_constructor:
    type: git
    url: https://github.com/Adaptive-Robotic-NDE/moveit_task_constructor.git
    version: iron
  # from sim.repos
  ros_ws/src/industrial_reconstruction:
    type: git
    url: https://github.com/Adaptive-Robotic-NDE/industrial_reconstruction.git
    version: iron
  # from sim.repos
  ros_ws/src/yolo_ros:
    type: git
    url: https://github.com/Adaptive-Robotic-NDE/yolo_ros.git
    version: iron
  # from sim.repos
  ros_ws/src/noether:
    type: git
    # tari/iron = upstream e64b330 (tag 0.16.0) + the min/max fix in
    # getDistancesToMinMaxCuts, where the two comparisons were chained with
    # `else if` so a corner that raised d_max could not also lower d_min --
    # feed the OBB corners in ascending order and d_min keeps its DBL_MAX
    # initialiser, which is what the plane count is computed from. Latent on
    # every mesh measured so far, and it fires once on a mesh whose corners
    # happen to arrive sorted.
    # upstream: https://github.com/ros-industrial/noether.git (master)
    url: https://github.com/Adaptive-Robotic-NDE/noether.git
    version: iron
  # from sim.repos
  ros_ws/src/boost_plugin_loader:
    type: git
    url: https://github.com/tesseract-robotics/boost_plugin_loader.git
    version: 0.4.3
  # from sim.repos
  ros_ws/src/ros_industrial_cmake_boilerplate:
    type: git
    url: https://github.com/ros-industrial/ros_industrial_cmake_boilerplate.git
    version: 0.7.4
  # from acq.repos
  # NOTE: the workspace tracks the feature branch bug_timedtransactionrace,
  #       which is not published; the public manifest tracks master, so a public
  #       build does not include the fixes on that branch
  spatialnde2:
    type: git
    url: https://github.com/isuthermography/spatialnde2.git
    version: master
  # from acq.repos
  dataguzzler-python:
    type: git
    url: https://github.com/isuthermography/dataguzzler-python.git
    version: master
  # from acq.repos
  dgpython-param-manager:
    type: git
    url: https://github.com/lesthaeghet/dgpython-param-manager.git
    version: master
  # from acq.repos
  dgpython-local:
    type: git
    url: https://github.com/isuthermography/dgpython-local.git
    version: master
  # from acq.repos
  spatialnde2-ec-functions:
    type: git
    url: https://github.com/Adaptive-Robotic-NDE/spatialnde2-ec-functions.git
    version: main
  # from acq.repos
  ROS-Scanning:
    type: git
    url: https://github.com/Adaptive-Robotic-NDE/ROS-Scanning.git
    version: main
  # from hw.repos
  ros_ws/src/azure_kinect_ros_driver:
    type: git
    url: https://github.com/Adaptive-Robotic-NDE/azure_kinect_ros_driver.git
    version: main
  # from hw.repos
