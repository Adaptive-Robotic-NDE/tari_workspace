    type: git
    url: https://github.com/Adaptive-Robotic-NDE/azure_kinect_python_ros2_driver.git
    version: iron
  # from hw.repos
  ros_ws/src/libsocket:
    type: git
    url: https://github.com/dermesser/libsocket.git
    version: 6214af728874b98055eefed293274540d98f6568
  # from hw.repos
  dgpython-azurekinect:
    type: git
    url: https://github.com/isuthermography/dgpython-azurekinect.git
    version: master
  # from hw.repos
